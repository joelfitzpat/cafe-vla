<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.9'>
  <world name="cafe_world">
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>


    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <include>
      <uri>
      model://krytn/worlds/Cafe
      </uri>

    </include>

    <!-- Camera 1: entrance end, looking into the room (+Y), pitched 15 deg down.
         At 2.5 m height to clear the robot. 90 deg FOV covers the full cafe width. -->
    <model name="entrance_camera">
      <static>true</static>
      <pose>-0.4 -10.0 2.5 0 -0.26 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.1 0.05</size></box>
          </geometry>
        </visual>
        <sensor name="entrance_cam" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/entrance_camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>224</width>
              <height>224</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Camera 2: far end, looking back toward the entrance (-Y), pitched 15 deg down.
         Complementary to Camera 1 — when the robot moves toward one camera it moves
         away from the other, so occlusion of the action space is minimised. -->
    <model name="far_camera">
      <static>true</static>
      <pose>-0.4 5.0 2.5 0 -0.26 -1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.1 0.05</size></box>
          </geometry>
        </visual>
        <sensor name="far_cam" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/far_camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>224</width>
              <height>224</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
