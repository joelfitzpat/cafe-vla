<?xml version="1.0"?>
<robot name="cafe_robot">

  <!--
    Minimal robot: a box body with a front-mounted camera.
    Spawned at (-2.5, 0, 0) facing +x toward the delivery table.
    Camera publishes sensor_msgs/Image to /cafe/camera/image_raw.
  -->

  <!-- Base body: 0.3 x 0.3 x 0.4 m box -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><box size="0.3 0.3 0.4"/></geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><box size="0.3 0.3 0.4"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="5.0"/>
      <!-- Solid box inertia: m*(w^2+h^2)/12 etc. (0.3x0.3x0.4, 5 kg) -->
      <inertia ixx="0.1042" ixy="0" ixz="0"
               iyy="0.1042" iyz="0"
               izz="0.075"/>
    </inertial>
  </link>

  <!-- Camera link: sits at front of body, 0.28 m above base_link origin -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000208" ixy="0" ixz="0"
               iyy="0.0000208" iyz="0"
               izz="0.0000208"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Front of body (+x), centred, 0.28 m up -->
    <origin xyz="0.15 0 0.28" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo camera sensor attached to camera_link -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="cafe_camera">
      <always_on>true</always_on>
      <update_rate>5.0</update_rate>
      <camera name="cafe_camera">
        <!-- ~60 degree horizontal FOV -->
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>224</width>
          <height>224</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/cafe</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>cafe_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
